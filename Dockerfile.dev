FROM node:22-alpine

WORKDIR /app

# Enable corepack and use pnpm 9.x
RUN corepack enable pnpm && corepack prepare pnpm@9.15.4 --activate

# Install dependencies
COPY package.json pnpm-lock.yaml ./
COPY .npmrc ./
COPY prisma ./prisma
RUN pnpm install

# Copy source code
COPY . .

EXPOSE 3000

CMD ["sh", "-c", "pnpm prisma generate && pnpm prisma migrate deploy && pnpm dev"]
